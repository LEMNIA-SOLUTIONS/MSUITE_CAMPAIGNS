  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "CAMP-.YYYY.-.#####",
   "default": "CAMP-.YYYY.-.#####",
   "hidden": 1,
   "reqd": 1
  },
  {
   "fieldname": "campaign_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Campaign Name",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "objective",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Objective",
   "options": "\nAwareness\nTraffic\nEngagement\nRe-engagement\nLeads\nSales\nApp Promotion\nCustom",
   "description": "Set once on the umbrella; inherited by every child Social Post + Ad Campaign. Ad publishing maps these to Meta's OUTCOME_* values."
  },
  {
   "fieldname": "goal",
   "fieldtype": "Small Text",
   "label": "Goal",
   "description": "Free-text description (the human story). Objective above drives the platform-level optimisation."
  },
  {
   "fieldname": "column_break_overview",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "Draft\nScheduled\nIn Progress\nActive\nPaused\nCompleted\nPartially Failed\nFailed\nCancelled\nArchived",
   "default": "Draft",
   "reqd": 1
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Datetime",
   "in_list_view": 1,
   "label": "Start Date",
   "description": "Campaign goes live at this moment. Child Social posts / Ad campaigns can only schedule on or after this time."
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Datetime",
   "label": "End Date",
   "description": "Campaign window closes at this moment. Child schedules cannot fall after this time."
  },
  {
   "collapsible": 1,
   "fieldname": "section_budget",
   "fieldtype": "Section Break",
   "label": "Budget"
  },
  {
   "fieldname": "budget",
   "fieldtype": "Currency",
   "label": "Budget"
  },
  {
   "fieldname": "column_break_budget",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "spent",
   "fieldtype": "Currency",
   "label": "Spent",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "section_tracking",
   "fieldtype": "Section Break",
   "label": "UTM Tracking",
   "description": "Set once on the campaign; the publisher auto-injects these tags into every URL inside child Social Post captions. Empty fields are skipped (you don't need to fill all five)."
  },
  {
   "fieldname": "utm_source",
   "fieldtype": "Data",
   "label": "UTM Source",
   "description": "Defaults to the platform name per post (facebook, instagram, ...). Set here to force a single value across platforms."
  },
  {
   "fieldname": "utm_medium",
   "fieldtype": "Data",
   "label": "UTM Medium",
   "default": "social"
  },
  {
   "fieldname": "column_break_tracking",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "utm_campaign",
   "fieldtype": "Data",
   "label": "UTM Campaign",
   "description": "Defaults to a URL-safe slug of the campaign name when blank."
  },
  {
   "fieldname": "utm_term",
   "fieldtype": "Data",
   "label": "UTM Term"
  },
  {
   "collapsible": 1,
   "fieldname": "section_engagement",
   "fieldtype": "Section Break",
   "label": "First Comment"
  },
  {
   "fieldname": "first_comment_template",
   "fieldtype": "Long Text",
   "label": "First-Comment Template",
   "description": "Auto-posted as the first comment after each child post publishes (Meta only). Variables: {hashtags}, {campaign_name}, {link}. Leave blank to skip."
  },
  {
   "collapsible": 1,
   "fieldname": "section_recurrence",
   "fieldtype": "Section Break",
   "label": "Recurrence"
  },
  {
   "fieldname": "recurrence_pattern",
   "fieldtype": "Select",
   "label": "Repeat Every",
   "options": "\nDaily\nWeekly\nMonthly",
   "description": "Clone the whole campaign (UTM, first-comment, all child Social Posts) on this cadence."
  },
  {
   "fieldname": "recurrence_interval",
   "fieldtype": "Int",
   "label": "Interval",
   "default": "1",
   "depends_on": "recurrence_pattern",
   "description": "Repeat every N units of the chosen pattern (e.g. 2 + Weekly = every other week)."
  },
  {
   "fieldname": "column_break_recurrence",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "recurrence_end_at",
   "fieldtype": "Datetime",
   "label": "Repeat Until",
   "depends_on": "recurrence_pattern"
  },
  {
   "fieldname": "next_run_at",
   "fieldtype": "Datetime",
   "label": "Next Run At",
   "read_only": 1,
   "depends_on": "recurrence_pattern",
   "description": "Computed from start_date + pattern; updated each time the cloner fires."
  },
